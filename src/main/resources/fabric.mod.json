{
  "schemaVersion": 1,
  "id": "anti-gunpowder-farm",
  "version": "${version}",
  "name": "Anti Gunpowder Farm",
  "description": "Prevents automated gunpowder farming by blocking drops from Creepers, Ghasts, and Witches unless killed manually and not on cooldown.",
  "authors": ["Kieran Beals"],
  "contact": {
    "homepage": "https://github.com/kieranbeals/anti-gunpowder-farm",
    "sources": "https://github.com/kieranbeals/anti-gunpowder-farm"
  },
  "license": "CC0-1.0",
  "icon": "assets/anti-gunpowder-farm/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": ["com.kieranbeals.AntiGunpowderFarm"]
  },
  "mixins": ["anti-gunpowder-farm.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
